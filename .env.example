# Supabase project settings (Dashboard > Project Settings > API Keys / Data API).
# Both values are public by design; data is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Lets anyone who signs in create a new organization. Leave it off while the
# product is used by invitation only.
ALLOW_NEW_ORGANIZATIONS=false
